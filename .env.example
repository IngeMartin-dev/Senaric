# =====================================================================
# Tienda de Artesanías — Variables de entorno (ejemplo)
# Copia este archivo a ".env" y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# =====================================================================

APP_NAME="Tienda de Artesanías"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tu-dominio.com
APP_TIMEZONE=America/Bogota

# Clave interna usada para firmar sesiones/CSRF. Genera con:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=pon-aqui-una-clave-aleatoria-de-64-caracteres-hex

# ---------------------------------------------------------------------
# Supabase — credenciales
# La URL y la clave PUBLISHABLE (anon) pueden exponerse al frontend.
# La SERVICE_ROLE_KEY SOLO debe vivir en el backend (este PHP). NUNCA
# la envíes al navegador.
# ---------------------------------------------------------------------
SUPABASE_URL=https://lxkefzsobelxxqvamiwp.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_hl9lc52UdcTlQoRl7-yv-w_BFj6KE3I
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
SUPABASE_JWT_SECRET=tu-jwt-secret-aqui

# ---------------------------------------------------------------------
# Sesión / cookies
# ---------------------------------------------------------------------
SESSION_NAME=tienda_session
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

# ---------------------------------------------------------------------
# Rate limiting (requests/minuto por IP)
# ---------------------------------------------------------------------
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_CONTACT=5

# ---------------------------------------------------------------------
# Correo de contacto (formulario público)
# ---------------------------------------------------------------------
MAIL_TO=contacto@tu-dominio.com
MAIL_FROM=no-reply@tu-dominio.com

# ---------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------
LOG_LEVEL=info
LOG_PATH=storage/logs

# ---------------------------------------------------------------------
# Admin
# Crea tu usuario administrador directamente en Supabase Auth y coloca
# aquí su email para sincronizar el rol al iniciar sesión.
# ---------------------------------------------------------------------
ADMIN_EMAILS=admin@tu-dominio.com